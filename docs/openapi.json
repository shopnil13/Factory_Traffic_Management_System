  "components": {
    "schemas": {
      "AdminCommandSchema": {
        "properties": {
          "command_type": {
            "type": "string",
            "title": "Command Type"
          },
          "direction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Direction"
              },
              {
                "type": "null"
              }
            ]
          },
          "requested_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested By",
            "default": "admin"
          }
        },
        "type": "object",
        "required": [
          "command_type"
        ],
        "title": "AdminCommandSchema"
      },
      "ControllerAckSchema": {
        "properties": {
          "command_id": {
            "type": "string",
            "title": "Command Id"
          },
          "junction_id": {
            "type": "string",
            "title": "Junction Id"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "reported_state": {
            "$ref": "#/components/schemas/Signal"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "default": "SUCCESS"
          }
        },
        "type": "object",
        "required": [
          "command_id",
          "junction_id",
          "direction",
          "reported_state"
        ],
        "title": "ControllerAckSchema"
      },
      "DeviceStatus": {
        "type": "string",
        "enum": [
          "ONLINE",
          "OFFLINE",
          "DEGRADED",
          "WARNING",
          "UNKNOWN"
        ],
        "title": "DeviceStatus"
      },
      "DeviceStatusSchema": {
        "properties": {
          "junction_id": {
            "type": "string",
            "title": "Junction Id"
          },
          "component_type": {
            "type": "string",
            "title": "Component Type"
          },
          "identifier": {
            "type": "string",
            "title": "Identifier"
          },
          "status": {
            "$ref": "#/components/schemas/DeviceStatus"
          }
        },
        "type": "object",
        "required": [
          "junction_id",
          "component_type",
          "identifier",
          "status"
        ],
        "title": "DeviceStatusSchema"
      },
      "Direction": {
        "type": "string",
        "enum": [
          "NORTH",
          "SOUTH",
          "EAST",
          "WEST"
        ],
        "title": "Direction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JunctionCreateSchema": {
        "properties": {
          "junction_id": {
            "type": "string",
            "title": "Junction Id",
            "description": "Unique alphanumeric identifier for the junction"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Human-readable name"
          },
          "timing": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timing",
            "description": "Optional custom timing parameters"
          },
          "phases": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "$ref": "#/components/schemas/Direction"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phases",
            "description": "Optional phase definitions"
          }
        },
        "type": "object",
        "required": [
          "junction_id",
          "name"
        ],
        "title": "JunctionCreateSchema"
      },
      "SensorEventSchema": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "junction_id": {
            "type": "string",
            "title": "Junction Id"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "vehicle_id": {
            "type": "string",
            "title": "Vehicle Id"
          },
          "vehicle_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VehicleType"
              },
              {
                "type": "null"
              }
            ]
          },
          "sequence_no": {
            "type": "integer",
            "title": "Sequence No"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "junction_id",
          "event_type",
          "direction",
          "vehicle_id",
          "sequence_no",
          "timestamp"
        ],
        "title": "SensorEventSchema"
      },
      "Signal": {
        "type": "string",
        "enum": [
          "RED",
          "YELLOW",
          "GREEN",
          "UNKNOWN"
        ],
        "title": "Signal"
      },
      "SimulatorConfigSchema": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "delay_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Ms",
            "default": 50
          },
          "auto_ack": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto Ack",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "SimulatorConfigSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VehicleType": {
        "type": "string",
        "enum": [
          "EMERGENCY",
          "TRUCK",
          "FORKLIFT",
          "EMPLOYEE_VEHICLE"
        ],
        "title": "VehicleType"
      }
    }
  }
